    "apps/frontend",
    "apps/api", 
    "apps/web",
    "packages/*"
  ],
  "dependencies": {
    "docsify-cli": "^4.4.4",
    "normalize.css": "^8.0.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.6",
    "styled-components": "^6.1.19"
  }
